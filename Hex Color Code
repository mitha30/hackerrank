import re
n = int(input())
inside_block = False

for _ in range(n):
    line = input()
    if '{' in line:
        inside_block = True
        parts = line.split('{', 1)
        line = parts[1] 
    if '}' in line:
        inside_block = False
    
    if inside_block:
        matches = re.findall(r'#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{3})(?=[;,\)\s])', line)
        for color in matches:
            print(color)

