import re

def is_valid_float(s):
    
    pattern = r'^[+-]?[0-9]*\.[0-9]+$'
    
    
    if not re.match(pattern, s):
        return False
    
    try:
        float(s)
        return True
    except ValueError:
        return False

t = int(input())

for _ in range(t):
    test_string = input().strip()
    print(is_valid_float(test_string))
