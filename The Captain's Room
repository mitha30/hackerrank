k = int(input())

# Read the room numbers and convert to a list of integers
room_list = list(map(int, input().split()))

# Create a set of unique room numbers
room_set = set(room_list)

# Apply the mathematical formula
# (Sum of unique elements * K) - (Actual sum of all elements)
# This difference is exactly (K-1) * Captain's Room Number
captain_room = (sum(room_set) * k - sum(room_list)) // (k - 1)

print(captain_room)
